# Database
# Leave blank or set to custom MongoDB URI. If blank/unavailable locally, automatic in-memory MongoDB will be used.
MONGODB_URI=mongodb://localhost:27017/inject-ui

# JWT Secret for authentication tokens
JWT_SECRET=inject_ui_development_jwt_secret_key_987654321

# Default Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
